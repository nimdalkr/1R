# 쿠팡 파트너스의 최종 승인 후 발급받은 키. 판매자 WING API 키가 아닙니다.
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
# 선택: 파트너스에 등록한 채널 ID만 사용. 미등록 값을 임의로 만들지 마세요.
COUPANG_SUB_ID=
# 온라인 /admin 에서 후보 검색·검수를 사용할 때만 필요. 무작위 24자 이상.
# 로컬 npm start는 미설정 시 임시 관리자 토큰을 생성해 터미널에 출력합니다.
CATALOG_ADMIN_TOKEN=
# 내부 안전 예산. 계정의 실제 제한을 확인한 뒤 필요할 때 변경.
COUPANG_SEARCH_LIMIT_HOUR=8
COUPANG_LINK_LIMIT_HOUR=100
COUPANG_TIMEOUT_MS=7000
# 선택: 여러 서버 인스턴스의 계정 호출 예산을 공유. 실패 시 외부 호출 중단.
# 미설정 상태의 제한은 인스턴스 단위이며 계정 전체 제한을 보장하지 않습니다.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
