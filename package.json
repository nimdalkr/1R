{
  "name": "1r",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "description": "1R — local-first 2D/3D room studio, inventory, layout alternatives and verified furniture",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/build-sites.mjs",
    "start": "node scripts/serve.mjs",
    "dev": "node scripts/build.mjs && node scripts/build-sites.mjs && node scripts/serve.mjs --sites",
    "test": "node --test tests/*.test.mjs",
    "catalog:check": "node scripts/catalog.mjs check",
    "catalog:import": "node scripts/catalog.mjs import",
    "coupang:check": "node scripts/coupang-check.mjs",
    "test:browser": "python tests/studio_browser.py",
    "build:web": "node scripts/build.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild": "0.25.12"
  }
}
